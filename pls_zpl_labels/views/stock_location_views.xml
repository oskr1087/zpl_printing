<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_location_form_pls_zpl" model="ir.ui.view">
        <field name="name">stock.location.form.pls.zpl</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <xpath expr="//field[@name='name']" position="after">
                <div class="o_pls_location_structure mt-3 mb-3">
                    <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                        <div>
                            <div class="fw-bold">Estructura PLS</div>
                            <small class="text-muted">El nombre se genera automáticamente.</small>
                        </div>
                        <button name="action_open_zpl_preview_location"
                                string="Imprimir etiqueta"
                                type="object"
                                icon="fa-print"
                                class="btn btn-primary"/>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <group>
                                <field name="pls_aisle" placeholder="Ej. A1"/>
                                <field name="pls_level" placeholder="Ej. N5"/>
                            </group>
                        </div>
                        <div class="col-12 col-md-6">
                            <group>
                                <field name="pls_column" placeholder="Ej. C1"/>
                                <field name="pls_position" placeholder="Ej. 01"/>
                            </group>
                        </div>
                    </div>

                    <div class="o_pls_location_code_line mt-2">
                        <span class="text-muted me-2">Código:</span>
                        <field name="name" nolabel="1" readonly="1" class="o_pls_location_code_inline"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_stock_location_zpl_preview" model="ir.actions.server">
        <field name="name">Imprimir etiqueta</field>
        <field name="model_id" ref="stock.model_stock_location"/>
        <field name="binding_model_id" ref="stock.model_stock_location"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records[:1].action_open_zpl_preview_location() if records else False</field>
    </record>
</odoo>
