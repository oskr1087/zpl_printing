<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_location_form_pls_zpl" model="ir.ui.view">
        <field name="name">stock.location.form.pls.zpl</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <group string="Estructura PLS" col="4">
                    <field name="pls_aisle"/>
                    <field name="pls_column"/>
                    <field name="pls_level"/>
                    <field name="pls_position"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
