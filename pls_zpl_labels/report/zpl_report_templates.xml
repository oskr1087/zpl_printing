    </template>

    <!-- ================================================================ -->
    <!-- UBICACION - 4 x 6 pulgadas - COLOR / QWEB PDF                    -->
    <!-- Se imprime como PDF mediante QZ Tray para conservar los colores. -->
    <!-- Pasillo azul, Columna verde, Nivel naranja, Posicion morado.      -->
    <!-- ================================================================ -->
    <template id="report_location_color_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="pls-location-label">
                    <div class="pls-top">
                        <div class="pls-brand">PLS LOGISTICS</div>
                        <div class="pls-type">UBICACIÓN DE ALMACÉN</div>
                    </div>

                    <div class="pls-code-row" aria-label="Código de ubicación">
                        <span class="pls-code-blue"><t t-esc="o.pls_aisle or ''"/></span><span class="pls-code-green"><t t-esc="o.pls_column or ''"/></span><span class="pls-code-orange"><t t-esc="o.pls_level or ''"/></span><span class="pls-code-purple"><t t-esc="o.pls_position or ''"/></span>
                    </div>

                    <div class="pls-barcode-wrap">
                        <img t-att-src="'/report/barcode/Code128/%s?width=1050&amp;height=180&amp;humanreadable=0' % (o.name or '')" class="pls-barcode"/>
                        <div class="pls-barcode-text"><t t-esc="o.name or ''"/></div>
                    </div>

                    <div class="pls-components">
                        <div class="pls-box pls-blue">
                            <div class="pls-box-title">PASILLO</div>
                            <div class="pls-box-value"><t t-esc="o.pls_aisle or '-'"/></div>
                        </div>
                        <div class="pls-box pls-green">
                            <div class="pls-box-title">COLUMNA</div>
                            <div class="pls-box-value"><t t-esc="o.pls_column or '-'"/></div>
                        </div>
                        <div class="pls-box pls-orange">
                            <div class="pls-box-title">NIVEL</div>
                            <div class="pls-box-value"><t t-esc="o.pls_level or '-'"/></div>
                        </div>
                        <div class="pls-box pls-purple">
                            <div class="pls-box-title">POSICIÓN</div>
                            <div class="pls-box-value"><t t-esc="o.pls_position or '-'"/></div>
                        </div>
                    </div>

                    <div class="pls-warning">
                        <div class="pls-warning-title">IMPORTANTE</div>
                        <div>VERIFIQUE SIEMPRE LA UBICACIÓN</div>
                        <div>ANTES DE REALIZAR CUALQUIER MOVIMIENTO.</div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <template id="report_location_color">
        <t t-call="web.basic_layout">
            <style>
                @page { size: 4in 6in; margin: 0; }
                html, body { margin: 0 !important; padding: 0 !important; }
                .page { margin: 0 !important; padding: 0 !important; }
                .pls-location-label {
                    width: 4in;
                    height: 6in;
                    box-sizing: border-box;
                    padding: 0.12in;
                    font-family: Arial, Helvetica, sans-serif;
                    color: #111;
                    background: #fff;
                    border: 2px solid #111;
                    overflow: hidden;
                }
                .pls-top { text-align: center; }
                .pls-brand {
                    font-size: 10pt;
                    font-weight: 700;
                    letter-spacing: 1.2px;
                    margin-bottom: 0.06in;
                }
                .pls-type {
                    background: #0b4f8a;
                    color: #fff;
                    border-radius: 4px;
                    padding: 0.07in 0.04in;
                    font-size: 14pt;
                    font-weight: 800;
                    letter-spacing: .4px;
                }
                .pls-code-row {
                    margin-top: 0.11in;
                    text-align: center;
                    font-size: 45pt;
                    font-weight: 900;
                    line-height: 1;
                    letter-spacing: -2px;
                    white-space: nowrap;
                }
                .pls-code-blue { color: #1167b1; }
                .pls-code-green { color: #13853f; }
                .pls-code-orange { color: #f47b20; }
                .pls-code-purple { color: #7336a7; }
                .pls-barcode-wrap {
                    margin-top: 0.08in;
                    text-align: center;
                    border: 1px solid #aaa;
                    border-radius: 5px;
                    padding: 0.05in 0.04in 0.035in;
                }
                .pls-barcode { width: 3.45in; height: 0.58in; object-fit: fill; }
                .pls-barcode-text {
                    font-size: 14pt;
                    font-weight: 800;
                    letter-spacing: 3px;
                    margin-top: 0.015in;
                }
                .pls-components {
                    display: table;
                    width: 100%;
                    table-layout: fixed;
                    border-spacing: 0.05in;
                    margin-top: 0.08in;
                }
                .pls-box {
                    display: table-cell;
                    height: 0.95in;
                    color: #fff;
                    border-radius: 5px;
                    text-align: center;
                    vertical-align: middle;
                }
                .pls-blue { background: #1167b1; }
                .pls-green { background: #13853f; }
                .pls-orange { background: #f47b20; }
                .pls-purple { background: #7336a7; }
                .pls-box-title { font-size: 9pt; font-weight: 800; }
                .pls-box-value { font-size: 25pt; font-weight: 900; margin-top: 0.06in; }
                .pls-warning {
                    margin: 0.12in 0.03in 0;
                    padding: 0.08in;
                    background: #ffd51f;
                    border: 1px solid #d2aa00;
                    border-radius: 5px;
                    text-align: center;
                    font-size: 8.5pt;
                    font-weight: 700;
                    line-height: 1.25;
                }
                .pls-warning-title { font-size: 12pt; font-weight: 900; margin-bottom: 0.025in; }
            </style>
            <t t-call="pls_zpl_labels.report_location_color_document"/>
        </t>
    </template>

